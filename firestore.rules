rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function friendPairId(a, b) {
      return a < b ? a + '_' + b : b + '_' + a;
    }

    function isFriendOf(otherUid) {
      let pairId = friendPairId(request.auth.uid, otherUid);
      return exists(/databases/$(database)/documents/friendRequests/$(pairId)) &&
        get(/databases/$(database)/documents/friendRequests/$(pairId)).data.status == 'accepted';
    }

    // Account profile (settings, fcmTokens, username, birthdate): only the
    // owner ever reads or writes their own document.
    match /users/{uid} {
      allow read, write: if isOwner(uid);
    }

    // username -> uid lookup, used to find/add friends by username. Anyone
    // signed in can look one up (needed before a request exists); a mapping
    // can only be created by the uid it points to, and never reassigned to
    // someone else once claimed.
    match /usernames/{username} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // Friend requests: only the two people involved can see or act on one.
    // The doc id itself isn't trusted for authorization, only the fields.
    match /friendRequests/{requestId} {
      allow read: if isSignedIn() &&
        (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.fromUid == request.auth.uid;
      allow update, delete: if isSignedIn() &&
        (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
    }

    // Leaderboard entries: one doc per "{uid}_{sport}_{preset}", holding a
    // user's current best. Only that uid may write their own doc, and it can
    // only be read by its owner or an accepted friend (mirrors what the app
    // actually queries - never a stranger's data).
    match /leaderboardEntries/{entryId} {
      allow read: if isSignedIn() &&
        (entryId.split('_')[0] == request.auth.uid || isFriendOf(entryId.split('_')[0]));
      allow write: if isSignedIn() &&
        entryId.split('_')[0] == request.auth.uid &&
        request.resource.data.uid == request.auth.uid;
    }

    // In-app notifications: only the recipient can read/delete theirs.
    // They're only ever created by Cloud Functions (Admin SDK, bypasses
    // rules entirely), never directly by a client.
    match /notifications/{notifId} {
      allow read, delete: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create, update: if false;
    }

    // Everything else: denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
