rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function friendPairId(a, b) {
      return a < b ? a + '_' + b : b + '_' + a;
    }

    function isFriendOf(otherUid) {
      let pairId = friendPairId(request.auth.uid, otherUid);
      return exists(/databases/$(database)/documents/friendRequests/$(pairId)) &&
        get(/databases/$(database)/documents/friendRequests/$(pairId)).data.status == 'accepted';
    }

    // True if otherUid has blocked the caller - used to stop a blocked user
    // from sending a new friend request. exists() is checked first (in case
    // otherUid's profile doc is somehow missing) since get() on a path that
    // doesn't exist errors out rather than returning null, and blockedUids
    // itself is presence-checked since most users never block anyone.
    function isBlockedBy(otherUid) {
      let otherPath = /databases/$(database)/documents/users/$(otherUid);
      return exists(otherPath) &&
        ('blockedUids' in get(otherPath).data) &&
        request.auth.uid in get(otherPath).data.blockedUids;
    }

    // Account profile (settings, fcmTokens, username, birthdate): only the
    // owner ever reads or writes their own document.
    match /users/{uid} {
      allow read, write: if isOwner(uid);
    }

    // username -> uid lookup, used to find/add friends by username. Anyone
    // signed in can look one up (needed before a request exists); a mapping
    // can only be created by the uid it points to, and never reassigned to
    // someone else once claimed.
    match /usernames/{username} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      // resource == null covers a get() on a username that isn't claimed yet
      // (the normal case when checking availability) - resource.data on a
      // nonexistent doc errors out rather than reading as "not found".
      allow update, delete: if isSignedIn() && resource != null && resource.data.uid == request.auth.uid;
    }

    // Friend requests: only the two people involved can see or act on one.
    // The doc id itself isn't trusted for authorization, only the fields.
    // resource == null covers a get() by pairId before any request exists
    // yet (the normal case the first time you add someone).
    match /friendRequests/{requestId} {
      allow read: if isSignedIn() &&
        (resource == null || resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow create: if isSignedIn() &&
        request.resource.data.fromUid == request.auth.uid &&
        !isBlockedBy(request.resource.data.toUid);
      allow update, delete: if isSignedIn() &&
        (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
    }

    // Leaderboard entries: one doc per "{uid}_{sport}_{preset}", holding a
    // user's current best. Only that uid may write their own doc, and it can
    // only be read by its owner or an accepted friend (mirrors what the app
    // actually queries - never a stranger's data).
    match /leaderboardEntries/{entryId} {
      // Keyed off the "uid" field, not entryId, even though entryId also
      // encodes it ("{uid}_{sport}_{preset}") - Firestore can only allow a
      // list query (deleteAccount()'s cleanup uses where("uid","==",...)) if
      // it can prove every possible result satisfies the rule purely from
      // the query's own filters, and it can't reason about a transform like
      // entryId.split('_')[0] to do that, only a direct field comparison
      // that matches the query's filter exactly. resource == null covers a
      // get() on a friend's entry for a preset they have no record in yet.
      allow read: if isSignedIn() &&
        (resource == null || resource.data.uid == request.auth.uid || isFriendOf(resource.data.uid));
      // create/update need request.resource (the incoming doc); delete has no
      // such thing - request.resource is undefined for deletes, so folding
      // delete into the same "write" rule as create/update made every delete
      // silently fail (rule errors deny by default), leaving stale entries
      // behind whenever a best performance stopped qualifying or an account
      // was deleted.
      allow create, update: if isSignedIn() &&
        entryId.split('_')[0] == request.auth.uid &&
        request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn() && entryId.split('_')[0] == request.auth.uid;
    }

    // True if the caller is an accepted participant of challengeId.
    function isChallengeParticipant(challengeId) {
      let pPath = /databases/$(database)/documents/challengeParticipants/$(challengeId + '_' + request.auth.uid);
      return exists(pPath) && get(pPath).data.status == 'accepted';
    }

    // A challenge's own details (sport, preset, dates, creator) - no
    // performance data lives here. Readable by anyone signed in (an invited
    // user needs to see it before deciding to accept), immutable once
    // created for this first version.
    match /challenges/{challengeId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.creatorUid == request.auth.uid;
      allow update, delete: if false;
    }

    // One doc per "{challengeId}_{uid}": an invite, and once accepted, proof
    // of participation used by the two functions above. The creator writes
    // one per invited friend (status "pending") plus their own (status
    // "accepted", auto-joining their own challenge) in the same batch as
    // creating the challenge; only the invited uid can then flip their own
    // doc to "accepted"/"declined", or delete it to leave later.
    match /challengeParticipants/{participantId} {
      allow read: if isSignedIn() &&
        (resource == null || resource.data.uid == request.auth.uid || isChallengeParticipant(resource.data.challengeId));
      // Not cross-checked against challenges/{challengeId}.creatorUid: that
      // doc is created in the same batch as these participant docs, and a
      // get() here doesn't see a sibling write from the same uncommitted
      // batch, so it always read as "doesn't exist yet" and denied every
      // creation. invitedBy == request.auth.uid already stops anyone from
      // forging an invite as coming from someone else.
      allow create: if isSignedIn() &&
        request.resource.data.invitedBy == request.auth.uid &&
        request.resource.data.status in ['pending', 'accepted'];
      allow update: if isSignedIn() && resource.data.uid == request.auth.uid &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.status in ['accepted', 'declined'];
      allow delete: if isSignedIn() && resource != null && resource.data.uid == request.auth.uid;
    }

    // One doc per "{challengeId}_{uid}": that participant's current best
    // within the challenge's window, kept in sync client-side by their own
    // device whenever they save a matching perf (mirrors leaderboardEntries).
    // Readable by fellow participants even if not mutual friends - a
    // challenge can include people who don't otherwise know each other.
    match /challengeEntries/{entryId} {
      allow read: if isSignedIn() && (resource == null || isChallengeParticipant(resource.data.challengeId));
      allow create, update: if isSignedIn() &&
        request.resource.data.uid == request.auth.uid &&
        isChallengeParticipant(request.resource.data.challengeId);
      allow delete: if isSignedIn() && resource != null && resource.data.uid == request.auth.uid;
    }

    // Abuse reports: write-only from the client. Only readable by the
    // developer, via the Firebase console (Admin SDK bypasses rules) - not
    // exposed back to any client, including the reporter.
    match /reports/{reportId} {
      allow create: if isSignedIn() && request.resource.data.reporterUid == request.auth.uid;
      allow read, update, delete: if false;
    }

    // In-app notifications: only the recipient can read/delete theirs.
    // They're only ever created by Cloud Functions (Admin SDK, bypasses
    // rules entirely), never directly by a client.
    match /notifications/{notifId} {
      allow read, delete: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create, update: if false;
    }

    // Everything else: denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
