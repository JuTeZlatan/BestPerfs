rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Proof photos, only ever uploaded to "proofs/{uid}/{perfId}/{photoId}.jpg"
    // by that same uid. Friends who are shown a shared photo on the leaderboard
    // access it through its own download-token URL (handed out via a
    // Firestore-gated leaderboardEntries doc), which works independently of
    // these rules - this just blocks anyone else from browsing or writing
    // into another user's folder directly.
    match /proofs/{uid}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Everything else: denied by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
